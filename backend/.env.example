DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dhl_incident_platform?schema=public
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-before-production
UIPATH_SHARED_SECRET=change-me-uipath
# OPENAI_API_KEY accepts any OpenAI-compatible key: native OpenAI (sk-...),
# NVIDIA NIM (nvapi-...), DeepSeek native (sk-...), Groq, Together, vLLM, Ollama, etc.
OPENAI_API_KEY=
# Default OPENAI_MODEL targets DeepSeek v3.1 served through NVIDIA NIM.
# For native OpenAI use a model like gpt-4o-mini and leave OPENAI_BASE_URL blank.
# For NVIDIA NIM also try: deepseek-ai/deepseek-r1, meta/llama-3.3-70b-instruct
# For DeepSeek native API use OPENAI_BASE_URL=https://api.deepseek.com/v1 and OPENAI_MODEL=deepseek-chat
OPENAI_MODEL=deepseek-ai/deepseek-v3.1
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_DEMO_PASSWORD=Passw0rd!
DEFAULT_ADMIN_EMAIL=admin.ops@dhl.local
DEFAULT_ADMIN_NAME=Operations Admin
BOOTSTRAP_ON_START=true
