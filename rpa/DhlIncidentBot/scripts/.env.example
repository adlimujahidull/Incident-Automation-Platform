# IMAP credentials for the email inbox the bot harvests
# Gmail: enable 2FA + generate an App Password (https://myaccount.google.com/apppasswords)
# Outlook/Office365: use an App Password or modern auth tooling

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

# Optional: move processed messages to this IMAP folder/label after attachments are extracted.
# Leave empty to keep them in the inbox.
IMAP_PROCESSED_FOLDER=

# Set to "false" to leave messages unread after processing (useful for testing).
IMAP_MARK_SEEN=true

# Where to write attachments. Relative to this scripts/ folder. Defaults to ../Data/Input.
IMAP_OUTPUT_DIR=../Data/Input

# Backend bridge configuration (used by `npm run process` only)
BACKEND_URL=http://localhost:4000
UIPATH_SHARED_SECRET=change-me-uipath
PROCESS_NAME=DHL Email Intake Bot
ADMIN_EMAIL=

